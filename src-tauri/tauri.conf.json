{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperGPT Connect",
  "version": "0.1.0",
  "identifier": "dev.supergpt.connect",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SuperGPT Connect",
        "width": 740,
        "height": 800,
        "minWidth": 380,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": [
      "../licenses/CC-Switch-MIT.txt",
      "../licenses/jsonc-parser-MIT.txt",
      "../licenses/THIRD-PARTY-NOTICES.txt"
    ]
  }
}
